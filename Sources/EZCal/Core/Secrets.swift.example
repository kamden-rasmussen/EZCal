// Copy this file to `Secrets.swift` (gitignored — never committed) and fill in your own values.
//
// These are baked into every copy of EZCal you build: there's no Settings UI for pasting a
// different client ID/secret, so whoever you send the app to signs in with these same OAuth
// clients without creating their own Google Cloud project or Zoom app.
//
// See README § "1. Google" for how to create these in https://console.cloud.google.com/
// (Application type: Desktop app), and § "2. Zoom" for https://marketplace.zoom.us/develop/create
// (General app → User-managed).
import Foundation

enum Secrets {
    static let googleClientID = ""
    static let googleClientSecret = ""
    static let zoomClientID = ""
    static let zoomClientSecret = ""
}
