// Copy this file to `Secrets.swift` (gitignored — never committed) and fill in your own values.
//
// This is a build-time fallback: it bakes your Google OAuth client into every copy of EZCal you
// build, so someone you send the app to can sign in with Google without creating their own Cloud
// Console project or pasting anything into Settings. Settings → Accounts still works and takes
// priority over these if someone pastes their own client ID/secret there instead.
//
// See README § "1. Google" for how to create these in https://console.cloud.google.com/
// (Application type: Desktop app).
import Foundation

enum Secrets {
    static let googleClientID = ""
    static let googleClientSecret = ""
}
